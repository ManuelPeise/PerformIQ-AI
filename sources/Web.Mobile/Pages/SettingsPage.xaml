<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Web.Mobile.Pages.SettingsPage"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="{Binding ApiBaseUrlLabelText}" />
            <Entry Placeholder="{Binding ApiBaseUrlPlaceholder}" Text="{Binding ApiBaseUrl}" />
            <Label Text="{Binding LanguageLabelText}" />
            <Picker ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguageCode}" />
            <VerticalStackLayout Spacing="14" Margin="0,6,0,0">
                <Button Text="{Binding SaveSettingsButtonText}" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding HasPendingChanges}" />
                <Button Text="{Binding RequestPermissionsButtonText}" Command="{Binding RequestPermissionsCommand}" />
            </VerticalStackLayout>

            <VerticalStackLayout Margin="0,28,0,0" Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{Binding SdkStatusLabelText}" />
                    <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding SdkStatusIcon}" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{Binding GrantedPermissionsLabelText}" />
                    <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding GrantedPermissionsSummary}" />
                </Grid>
            </VerticalStackLayout>

            <Button
                Margin="0,24,0,0"
                Text="{Binding LogoutButtonText}"
                Command="{Binding LogoutCommand}"
                IsVisible="{Binding CanLogout}"
                IsEnabled="{Binding CanLogout}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
