@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="app-shell @GetThemeClass()">
    <header class="navbar navbar-expand-lg navbar-dark bg-dark text-light p-2">
        <button type="button" class="header-button menu-toggle" aria-label="Toggle navigation menu" @onclick="ToggleSidebar">
            ☰
        </button>
        
        <a class="navbar-brand d-flex align-items-center navbar-logo" href="/">
            <img src="/images/perform_iq_ai_logo.png"
                 alt="Logo"
                 width="30"
                 height="30"
                 class="me-2">
            <span>PerformIq Ai</span>
        </a>
    </header>

    @if (_sidebarOpenOnMobile)
    {
        <button type="button" class="sidebar-overlay" aria-label="Close navigation menu" @onclick="CloseSidebar"></button>
    }

    <div class="layout-grid">
        <aside class="sidebar @GetSidebarClass() bg-dark text-light" aria-label="Primary">
            <nav class="sidebar-nav">
                <a class="nav-item text-light" href="/dashboard" @onclick="CloseSidebar">Dashboard (placeholder)</a>

                @* <button type="button" class="nav-group-toggle text-light" aria-expanded="@_managementExpanded" @onclick="ToggleManagement">
                    Management
                    <span class="chevron text-light">@(_managementExpanded ? "▴" : "▾" )</span>
                </button>
                @if (_managementExpanded)
                {
                    <div class="nav-group-items">
                        <a class="nav-item nested text-light" href="/users" @onclick="CloseSidebar">Users (placeholder)</a>
                        <a class="nav-item nested text-light" href="/roles" @onclick="CloseSidebar">Roles (placeholder)</a>
                    </div>
                } *@

                @* <button type="button" class="nav-group-toggle text-light" aria-expanded="@_modulesExpanded" @onclick="ToggleModules">
                    Modules
                    <span class="chevron text-light">@(_modulesExpanded ? "▴" : "▾")</span>
                </button>
                @if (_modulesExpanded)
                {
                    <div class="nav-group-items">
                        <a class="nav-item nested text-light" href="/training" @onclick="CloseSidebar">Training (placeholder)</a>
                        <a class="nav-item nested text-light" href="/health" @onclick="CloseSidebar">Health (placeholder)</a>
                        <a class="nav-item nested text-light" href="/performance" @onclick="CloseSidebar">Performance (placeholder)</a>
                    </div>
                } *@
                <a class="nav-item text-light" href="/profile" @onclick="CloseSidebar">Profile (placeholder)</a>
                <a class="nav-item text-light" href="/auth/logout" @onclick="CloseSidebar">Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string LightTheme = "light";
    private const string DarkTheme = "dark";

    private bool _sidebarOpenOnMobile;
    private bool _managementExpanded = true;
    private bool _modulesExpanded;
    private string _theme = LightTheme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var storedTheme = await JSRuntime.InvokeAsync<string>("performIqTheme.getStoredTheme");
        if (storedTheme is DarkTheme or LightTheme)
        {
            _theme = storedTheme;
        }
        else
        {
            var prefersDark = await JSRuntime.InvokeAsync<bool>("performIqTheme.prefersDark");
            _theme = prefersDark ? DarkTheme : LightTheme;
        }

        StateHasChanged();
    }

    private void ToggleSidebar()
    {
        _sidebarOpenOnMobile = !_sidebarOpenOnMobile;
    }

    private void CloseSidebar()
    {
        _sidebarOpenOnMobile = false;
    }

    private void ToggleManagement()
    {
        _managementExpanded = !_managementExpanded;
    }

    private void ToggleModules()
    {
        _modulesExpanded = !_modulesExpanded;
    }

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == DarkTheme ? LightTheme : DarkTheme;
        await JSRuntime.InvokeVoidAsync("performIqTheme.setStoredTheme", _theme);
    }

    private string GetThemeClass() => _theme == DarkTheme ? "theme-dark" : "theme-light";

    private string GetThemeToggleLabel() => _theme == DarkTheme ? "Light" : "Dark";

    private string GetSidebarClass() => _sidebarOpenOnMobile ? "open" : string.Empty;
}
