<section class="auth-hero" aria-label="@($"{Title} page")">
    <div class="auth-hero-background"></div>

    <div class="container auth-hero-content">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-5">
                <article class="card auth-card shadow border-0">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 text-center mb-4">@Title</h1>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mb-3" role="alert">@ErrorMessage</div>
                        }

                        <EditForm Model="Model" OnValidSubmit="OnValidSubmit" class="d-grid gap-2">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="mb-2" />
                            @Fields

                            <button class="btn btn-primary w-100 mt-2" type="submit" disabled="@IsSubmitting">
                                @(IsSubmitting ? SubmittingText : SubmitText)
                            </button>
                        </EditForm>

                        @if (Footer is not null)
                        {
                            <p class="auth-link text-center mt-4 mb-0">@Footer</p>
                        }
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required object Model { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter, EditorRequired]
    public required string SubmitText { get; set; }

    [Parameter, EditorRequired]
    public required string SubmittingText { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback OnValidSubmit { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment Fields { get; set; }

    [Parameter]
    public RenderFragment? Footer { get; set; }
}
