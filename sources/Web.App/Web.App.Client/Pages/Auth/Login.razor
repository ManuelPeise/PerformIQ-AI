@page "/auth/login"
@rendermode InteractiveWebAssembly
@inject LoginViewModel ViewModel

<PageTitle>Login</PageTitle>

<AuthFormCard
    Title="Login"
    Model="ViewModel.Model"
    ErrorMessage="@ViewModel.ErrorMessage"
    SubmitText="Sign in"
    SubmittingText="Signing in..."
    IsSubmitting="@ViewModel.IsSubmitting"
    OnValidSubmit="ViewModel.SubmitAsync">
    <Fields>
        <div class="mb-3">
            <label class="form-label" for="login-identifier">Username or email</label>
            <InputText id="login-identifier" class="form-control" @bind-Value="ViewModel.Model.UserNameOrEmail" />
        </div>

        <div class="mb-1">
            <label class="form-label" for="login-password">Password</label>
            <InputText id="login-password" class="form-control" type="password" @bind-Value="ViewModel.Model.Password" />
        </div>
    </Fields>
    <Footer>
        No account yet? <a href="/auth/register">Register</a>
    </Footer>
</AuthFormCard>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    protected override void OnParametersSet()
    {
        ViewModel.SetReturnUrl(ReturnUrl);
    }
}
