@page "/auth/register"
@rendermode InteractiveWebAssembly
@inject RegisterViewModel ViewModel

<PageTitle>Register</PageTitle>

<AuthFormCard
    Title="Register"
    Model="ViewModel.Model"
    ErrorMessage="@ViewModel.ErrorMessage"
    SubmitText="Create account"
    SubmittingText="Creating account..."
    IsSubmitting="@ViewModel.IsSubmitting"
    OnValidSubmit="ViewModel.SubmitAsync">
    <Fields>
        <div class="mb-3">
            <label class="form-label" for="register-username">Username</label>
            <InputText id="register-username" class="form-control" @bind-Value="ViewModel.Model.UserName" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="register-email">Email</label>
            <InputText id="register-email" class="form-control" @bind-Value="ViewModel.Model.Email" />
        </div>

        <div class="mb-1">
            <label class="form-label" for="register-password">Password</label>
            <InputText id="register-password" class="form-control" type="password" @bind-Value="ViewModel.Model.Password" />
        </div>
    </Fields>
    <Footer>
        Already have an account? <a href="/auth/login">Login</a>
    </Footer>
</AuthFormCard>
