@page "/home"
@attribute [Authorize]
@rendermode InteractiveWebAssembly
@inject HomeViewModel ViewModel

<PageTitle>Home</PageTitle>

<h1>Home</h1>

@if (ViewModel.IsLoading)
{
    <p>Loading profile...</p>
}
else if (!string.IsNullOrWhiteSpace(ViewModel.ErrorMessage))
{
    <p class="text-danger">@ViewModel.ErrorMessage</p>
}
else if (ViewModel.Profile is null)
{
    <p>No profile available yet.</p>
}
else
{
    <p>Welcome, @ViewModel.Profile.FirstName @ViewModel.Profile.LastName.</p>
    <p>Email: @ViewModel.Profile.Email</p>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadAsync();
    }
}
